---
import '../fonts/montserrat-400.css'
import '@fontsource/montserrat/700.css'
import '../styles/base.css'
import { getDemos } from '../lib/demos'

interface Props {
  title: string
  description?: string
  /** 検索に出さない（404） */
  noindex?: boolean
}

const { title, description = '動きの実験のデモ', noindex = false } = Astro.props

const SITE_NAME = 'labobal.dev'
const url = new URL(Astro.url.pathname, Astro.site)
// デモのページ（/<slug>/）は、トップの一覧と同じポスターを使う。名前と大きさは webmanab の記事も使うので変えない
const slug = Astro.url.pathname.split('/')[1]
const demo = slug
  ? (await getDemos()).find((meta) => meta.slug === slug)
  : undefined
const image = demo
  ? { path: `/previews/${demo.slug}.jpg`, width: 480, height: 300 }
  : { path: '/og.png', width: 1200, height: 630 }
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#232931" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {!noindex && <link rel="canonical" href={url} />}
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_NAME}
      href={new URL('/rss.xml', Astro.site)}
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={demo ? 'article' : 'website'} />
    <meta property="og:url" content={url} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:image" content={new URL(image.path, Astro.site)} />
    <meta property="og:image:width" content={String(image.width)} />
    <meta property="og:image:height" content={String(image.height)} />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
