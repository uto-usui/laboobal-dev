---
import DemoLayout from '../layouts/DemoLayout.astro'
import { getDemos, loadDemoComponent, type DemoMeta } from '../lib/demos'

export const getStaticPaths = async () =>
  (await getDemos()).map((demo) => ({
    params: { slug: demo.slug },
    props: { demo },
  }))

interface Props {
  demo: DemoMeta
}

const { demo } = Astro.props
const Demo = await loadDemoComponent(demo.slug)
---

<DemoLayout demo={demo}>
  <Demo />
</DemoLayout>
