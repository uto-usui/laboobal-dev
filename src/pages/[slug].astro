---
import type { AstroComponentFactory } from 'astro/runtime/server/index.js'
import DemoLayout from '../layouts/DemoLayout.astro'
import { getDemos, type DemoMeta } from '../lib/demos'

export const getStaticPaths = async () =>
  (await getDemos()).map((demo) => ({
    params: { slug: demo.slug },
    props: { demo },
  }))

interface Props {
  demo: DemoMeta
}

const components = import.meta.glob<AstroComponentFactory>(
  '../demos/*/Demo.astro',
  { import: 'default' },
)

const { demo } = Astro.props
const Demo = await components[`../demos/${demo.slug}/Demo.astro`]()
---

<DemoLayout demo={demo}>
  <Demo />
</DemoLayout>
