---
import '../fonts/molle-mark.css'
import Base from '../layouts/Base.astro'
---

<Base title="404 | labobal.dev" description="ページが見つかりません" noindex>
  <p class="mark" aria-hidden="true">
    labobal.dev
  </p>
  <main class="wrap">
    <h1 class="code">404</h1>
    <p class="text">このページはありません。</p>
    <a class="back" href="/">
      labobal.dev
    </a>
  </main>
</Base>

<style>
  /* トップと同じ、後ろに薄く敷く名前（src/pages/index.astro の .mark） */
  .mark {
    position: fixed;
    top: 50%;
    left: 50%;
    margin: 0;
    font-family: 'Molle Mark', cursive;
    font-size: 18vw;
    font-style: italic;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0.05;
    transform: translate(-50%, -50%);
  }

  .wrap {
    position: relative;
    display: grid;
    place-content: center;
    justify-items: center;
    min-height: 100dvh;
    padding: 16px;
    text-align: center;
  }

  /* トップの名前と同じく線だけで描く */
  .code {
    margin: 0;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: clamp(120px, 32vw, 400px);
    font-weight: 400;
    line-height: 1;
    color: transparent;
    letter-spacing: -0.04em;
    -webkit-text-stroke: 1px var(--color-accent);
  }

  .text {
    margin: 16px 0 32px;
    font-size: 12px;
    color: var(--color-muted);
    letter-spacing: 0.08em;
  }

  .back {
    font-size: 12px;
    color: var(--color-accent);
    letter-spacing: 0.1em;
  }
</style>
