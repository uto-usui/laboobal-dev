---
import '../fonts/molle-mark.css'
import Base from '../layouts/Base.astro'
import { getDemos, getGroups } from '../lib/demos'
import { compareBy, DEFAULT_SORT, SORTS, yearOf } from '../lib/top-list'

const demos = (await getDemos()).toSorted(compareBy(DEFAULT_SORT))
const groups = await getGroups()

// 一覧の 1 行。組（#31）は 1 行にまとめ、名前の下に各バリエーションへのリンクを並べる。
// key は並べ替えに使う名前（組の名前か slug）。slug は名前を押したときに開くデモで、ポスターもこれを使う
const grouped = new Set(groups.flatMap((group) => group.variants))
const rows = [
  ...demos
    .filter((demo) => !grouped.has(demo.slug))
    .map((demo) => ({
      key: demo.slug,
      slug: demo.slug,
      title: demo.title,
      created: demo.created,
      members: [demo],
      group: undefined,
    })),
  ...groups.map((group) => {
    const members = group.variants.map(
      (slug) => demos.find((demo) => demo.slug === slug)!,
    )
    return {
      key: group.name,
      slug: group.default,
      title: group.title,
      // 新しい順は、組の中でいちばん新しいもので並べる
      created: members
        .map((demo) => demo.created)
        .toSorted()
        .at(-1)!,
      members,
      group,
    }
  }),
]
  // JS がなくても初期の並び（新しい順）で出るよう、ここで並べておく
  .toSorted((a, b) =>
    compareBy(DEFAULT_SORT)(
      { slug: a.key, created: a.created },
      { slug: b.key, created: b.created },
    ),
  )
  .map((row) => ({
    ...row,
    pick: row.members.some((demo) => demo.pick),
    // ここで作ったデモ（移植でないもの）を出した日。組なら、いちばん新しいもの
    added: row.members
      .filter((demo) => demo.batch === 'new' && demo.added)
      .map((demo) => demo.added)
      .toSorted()
      .at(-1),
  }))
// 新しい順のときは、年が替わる最初の項目に年を出す
const yearFirst = new Set(
  rows
    .filter((row, i) => yearOf(row.created) !== yearOf(rows[i - 1]?.created))
    .map((row) => row.key),
)

const picks = demos.filter((demo) => demo.pick)

// 何をすると動くかで絞る。meta.ts の interaction はテストでも使っていて、どのデモにも確かに入っている。pick は meta の pick。
// 数は行ではなくデモの本数で数える（組の行は、合うバリエーションのリンクだけを出す）
const FILTERS = [
  { key: 'all', label: 'all' },
  { key: 'pick', label: 'pick!' },
  { key: 'hover', label: 'hover' },
  { key: 'drag', label: 'drag' },
  { key: 'scroll', label: 'scroll' },
  { key: 'click', label: 'click' },
  { key: 'none', label: 'watch' },
] as const
const SPECULATION = {
  prefetch: [
    {
      where: {
        and: [
          { href_matches: '/*' },
          { selector_matches: ['.list a', '.picks a'] },
        ],
      },
      eagerness: 'moderate',
    },
  ],
}
const countOf = (key: string) =>
  key === 'all'
    ? demos.length
    : key === 'pick'
      ? picks.length
      : demos.filter((demo) => demo.interaction === key).length

// 旧トップの雰囲気（暗い背景、後ろに薄く Molle、線だけの大きな名前）を残し、locomotive をやめて素のスクロールにした案。
// 見た目は作者に見てもらってから決める（CLAUDE.md）
---

<Base title="labobal.dev">
  <!-- 名前に少しとどまったら、そのデモのページを先に取っておく。prerender は WebGL を裏で動かすことになるのでしない -->
  <script
    slot="head"
    type="speculationrules"
    is:inline
    set:html={JSON.stringify(SPECULATION)}
  />
  <p class="mark" aria-hidden="true">labobal.dev</p>
  <figure class="hero" aria-hidden="true">
    <img alt="">
  </figure>
  <main class="wrap">
    <h1 class="visually-hidden">labobal.dev</h1>
    <p class="lead">
      動きの実験のデモ。説明は{' '}
      <a href="https://webmanab.com/lab/">webmanab の lab</a>
      に。
    </p>
    {picks.length > 0 && (
      <section class="picks" aria-labelledby="picks-title">
        <h2 id="picks-title" class="picks-title">
          pick!
        </h2>
        <ul class="pick-list">
          {picks.map((demo) => (
            <li class="pick">
              <a
                class="pick-link"
                href={`/${demo.slug}/`}
                data-slug={demo.slug}
              >
                <span class="pick-frame">
                  <img
                    src={`/previews/${demo.slug}.webp`}
                    width="480"
                    height="300"
                    alt=""
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="pick-slug">{demo.slug}</span>
                </span>
                <span class="pick-name">{demo.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
    <div class="controls">
      <nav class="filters" aria-label="何をすると動くかで絞る">
        {FILTERS.map((filter) => (
          <button
            class="filter"
            type="button"
            data-filter={filter.key}
            data-molle={filter.key === 'pick' ? '' : undefined}
            aria-pressed={filter.key === 'all' ? 'true' : 'false'}
          >
            {filter.label}
            <sup>{countOf(filter.key)}</sup>
          </button>
        ))}
      </nav>
      <nav class="sorts" aria-label="並べ方">
        {SORTS.map((sort) => (
          <button
            class="filter"
            type="button"
            data-sort={sort.key}
            aria-pressed={sort.key === DEFAULT_SORT ? 'true' : 'false'}
          >
            {sort.label}
          </button>
        ))}
      </nav>
    </div>
    <ul class="list" data-sort={DEFAULT_SORT}>
      {rows.map((row) => (
        <li
          class="item"
          data-key={row.group ? row.key : undefined}
          data-interaction={row.group ? undefined : row.members[0].interaction}
          data-slug={row.slug}
          data-created={row.created}
          data-pick={row.pick ? '' : undefined}
          data-group={row.group ? '' : undefined}
          data-year-first={yearFirst.has(row.key) ? '' : undefined}
        >
          {row.created && (
            <span class="year" aria-hidden="true">
              {yearOf(row.created)}
            </span>
          )}
          <a
            class="link"
            href={`/${row.slug}/`}
            data-slug={row.slug}
            data-title={row.title}
          >
            <span class="slug">
              <span class="slug-text">{row.key}</span>
            </span>
            {row.added && (
              <span class="new-mark" data-added={row.added} hidden>
                new
              </span>
            )}
            {row.pick && (
              <span class="pick-mark" aria-hidden="true">
                pick!
              </span>
            )}
            <span class="title">{row.title}</span>
          </a>
          {row.group && (
            <ul
              class="variants"
              aria-label={`${row.group.title}のバリエーション`}
            >
              {row.members.map((demo) => (
                <li
                  class="variant"
                  data-interaction={demo.interaction}
                  data-pick={demo.pick ? '' : undefined}
                >
                  <a
                    class="variant-link"
                    href={`/${demo.slug}/`}
                    data-slug={demo.slug}
                    data-title={demo.title}
                  >
                    {demo.variant}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
  </main>
  <canvas class="preview-canvas" aria-hidden="true"></canvas>
  <figure class="preview" aria-hidden="true">
    <video muted loop playsinline preload="none"></video>
    <figcaption></figcaption>
  </figure>
</Base>

<script>
  import { isCoarsePointer, prefersReducedMotion } from '../shared/dom'
  import { watchLongSlugs } from '../lib/top-slug'
  import type { createGlPreview } from '../lib/top-preview'
  import { watchHero } from '../lib/top-hero'
  import {
    compareBy,
    DEFAULT_SORT,
    isSortKey,
    yearOf,
    type SortKey,
  } from '../lib/top-list'
  import { enterDemo, plateOf, type Plate } from '../lib/top-enter'

  const list = document.querySelector<HTMLElement>('.list')!
  const items = [...list.querySelectorAll<HTMLElement>('.item')]
  // 名前と、組の行のバリエーションのリンク。どちらも触れると動画を出し、押すと板を広げて入る
  const links = [
    ...list.querySelectorAll<HTMLAnchorElement>('.link, .variant-link'),
  ]
  const filters = [
    ...document.querySelectorAll<HTMLButtonElement>('.filters button'),
  ]
  const sorts = [
    ...document.querySelectorAll<HTMLButtonElement>('.sorts button'),
  ]

  // 絞り込みと並べ方は URL の ?filter=&sort= に残す。初期の値のときは付けない
  const params = new URLSearchParams(location.search)
  const filterParam = params.get('filter')
  const state = {
    filter: filters.some((b) => b.dataset.filter === filterParam)
      ? filterParam!
      : 'all',
    sort: isSortKey(params.get('sort')) ? params.get('sort')! : DEFAULT_SORT,
  } as { filter: string; sort: SortKey }

  // 並べ替えの名前。組の行は組の名前（data-key）、ほかは slug
  const keyOf = (item: HTMLElement) => item.dataset.key ?? item.dataset.slug!
  const matches = (el: HTMLElement) =>
    state.filter === 'pick'
      ? el.dataset.pick !== undefined
      : state.filter === 'all' || el.dataset.interaction === state.filter
  const render = () => {
    items.forEach((item) => {
      const variants = [...item.querySelectorAll<HTMLElement>('.variant')]
      if (variants.length === 0) {
        item.hidden = !matches(item)
        return
      }
      // 組の行は、合うバリエーションのリンクだけを出し、1 つもなければ行ごと隠す
      for (const variant of variants) variant.hidden = !matches(variant)
      item.hidden = variants.every((variant) => variant.hidden)
    })
    // CSS の order ではなく DOM の順を替える。読み上げと Tab の順も並びに合わせるため
    const sorted = items.toSorted((a, b) =>
      compareBy(state.sort)(
        { slug: keyOf(a), created: a.dataset.created },
        { slug: keyOf(b), created: b.dataset.created },
      ),
    )
    if (sorted.some((item, i) => list.children[i] !== item))
      list.append(...sorted)
    list.dataset.sort = state.sort
    let year = ''
    sorted
      .filter((item) => !item.hidden)
      .forEach((item) => {
        const y = yearOf(item.dataset.created)
        item.toggleAttribute('data-year-first', y !== '' && y !== year)
        year = y
      })
    filters.forEach((b) =>
      b.setAttribute('aria-pressed', String(b.dataset.filter === state.filter)),
    )
    sorts.forEach((b) =>
      b.setAttribute('aria-pressed', String(b.dataset.sort === state.sort)),
    )
  }

  const update = (change: Partial<typeof state>) => {
    Object.assign(state, change)
    const url = new URL(location.href)
    const set = (key: string, value: string, initial: string) =>
      value === initial
        ? url.searchParams.delete(key)
        : url.searchParams.set(key, value)
    set('filter', state.filter, 'all')
    set('sort', state.sort, DEFAULT_SORT)
    history.replaceState(history.state, '', url)
    // 並びが詰まる動きは、対応するブラウザでだけ付ける
    if (document.startViewTransition && !prefersReducedMotion())
      document.startViewTransition(render)
    else render()
  }

  filters.forEach((button) =>
    button.addEventListener('click', () =>
      update({ filter: button.dataset.filter }),
    ),
  )
  sorts.forEach((button) =>
    button.addEventListener('click', () =>
      update({ sort: button.dataset.sort as SortKey }),
    ),
  )
  render()
  if (!prefersReducedMotion()) watchLongSlugs(list)

  // ここで作ったデモ（移植でないもの）は、出してから 30 日の間 new を付ける。ビルドした日ではなく見た日で決める
  document.querySelectorAll<HTMLElement>('.new-mark').forEach((mark) => {
    mark.hidden = Date.now() - Date.parse(mark.dataset.added!) > 30 * 864e5
  })

  // マウスで触れられない端末では、真ん中に来た名前を主役にする（触れたときの動画の代わり）
  if (isCoarsePointer())
    watchHero(list, document.querySelector<HTMLElement>('.hero')!)

  // ピックアップは、マウスを重ねるとポスターの上で動画を流す。動きを減らす設定のときは流さない
  if (!isCoarsePointer() && !prefersReducedMotion())
    document
      .querySelectorAll<HTMLAnchorElement>('.pick-link')
      .forEach((link) => {
        let clip: HTMLVideoElement | undefined
        link.addEventListener('pointerenter', () => {
          if (!clip) {
            clip = Object.assign(document.createElement('video'), {
              muted: true,
              loop: true,
              playsInline: true,
              src: `/previews/${link.dataset.slug}.webm`,
            })
            link.querySelector('img')!.after(clip)
          }
          clip.play().catch(() => {})
        })
        link.addEventListener('pointerleave', () => clip?.pause())
      })

  // 入るときに広げる板。触れたときの板が出ていれば、そこから広げる
  let hoverPlate = (): Plate | undefined => undefined

  // 触れたときの動画。タッチの端末では出さない（触れた時点で開くので見る間がない）
  const preview = document.querySelector<HTMLElement>('.preview')!
  const video = preview.querySelector('video')!
  const caption = preview.querySelector('figcaption')!
  if (!isCoarsePointer()) {
    // ふだんは WebGL の板に貼って、ばねで追わせて曲げる（src/lib/top-preview.ts）。
    // 動きを減らす設定のときと WebGL が使えないときは、DOM の画像をカーソルの位置にそのまま出す
    type GlPreview = NonNullable<ReturnType<typeof createGlPreview>>
    // 使っている板。読み終えても、DOM の画像を出している間は替えない
    let gl: GlPreview | null = null
    let loaded: GlPreview | null = null
    const pointer = { x: innerWidth / 2, y: innerHeight / 2 }
    let lastFrame = { x: 0, y: 0, width: 0, tilt: 0 }
    hoverPlate = () =>
      !preview.classList.contains('is-active')
        ? undefined
        : gl
          ? {
              x: lastFrame.x,
              y: lastFrame.y,
              width: lastFrame.width,
              height: (lastFrame.width * 10) / 16,
              angle: lastFrame.tilt,
            }
          : plateOf(preview)

    // 項目を替えたときにすぐ出せるよう、画面に入った名前のポスターだけ読んでおく
    const prefetcher = new IntersectionObserver((entries) =>
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return
        const link = entry.target as HTMLAnchorElement
        gl?.prefetch([link.dataset.slug!])
        prefetcher.unobserve(link)
      }),
    )

    const useGl = () => {
      if (!loaded || gl) return
      gl = loaded
      preview.classList.add('is-gl')
      gl.setTarget(pointer.x, pointer.y)
      links.forEach((link) => prefetcher.observe(link))
    }

    // three は大きいので、ページを開いただけでは読まない。マウスを動かすかキーボードで移ったら読み始める
    const loadGl = async () => {
      removeEventListener('pointermove', loadGl)
      removeEventListener('focusin', loadGl)
      // 読めなければ DOM の画像のまま
      const lib = await import('../lib/top-preview').catch(() => null)
      if (!lib) return
      loaded = lib.createGlPreview(
        document.querySelector<HTMLCanvasElement>('.preview-canvas')!,
        (f) => {
          // 名前の帯は板の左下の角に付いていく
          lastFrame = f
          preview.style.width = `${f.width}px`
          preview.style.transform = `translate3d(${f.x}px, ${f.y}px, 0) translate(-50%, -50%) rotate(${f.tilt}rad) translate(${f.cornerX}px, ${f.cornerY}px)`
        },
        (slug) => {
          // 組の行では同じ slug のリンクが 2 つある（名前と、バリエーションのリンク）。触れているほうの題を出す
          const link =
            hovered?.dataset.slug === slug
              ? hovered
              : list.querySelector<HTMLAnchorElement>(`a[data-slug="${slug}"]`)
          caption.textContent = link?.dataset.title ?? ''
        },
      )
      // DOM の画像を出している最中なら、次に項目が替わったときに板へ移る
      if (!preview.classList.contains('is-active')) useGl()
    }
    if (!prefersReducedMotion()) {
      addEventListener('pointermove', loadGl)
      addEventListener('focusin', loadGl)
    }
    let hideTimer = 0
    let hovered: HTMLAnchorElement | undefined

    const place = (x: number, y: number) => {
      pointer.x = x
      pointer.y = y
      if (gl) gl.setTarget(x, y)
      else
        preview.style.transform = `translate3d(${x}px, ${y}px, 0) translate(-50%, -50%)`
    }
    addEventListener('pointermove', (event) =>
      place(event.clientX, event.clientY),
    )

    links.forEach((link) => {
      const show = () => {
        hovered = link
        clearTimeout(hideTimer)
        useGl()
        const slug = link.dataset.slug!
        if (gl) gl.show(slug)
        else {
          caption.textContent = link.dataset.title ?? ''
          video.poster = `/previews/${slug}.webp`
        }
        preview.classList.add('is-active')
      }
      // 名前と名前のすき間を通るたびに閉じると、ちらつく。少し待ち、隣に移ったら開いたまま中身だけ替える
      const hide = () => {
        hideTimer = window.setTimeout(() => {
          preview.classList.remove('is-active')
          gl?.hide()
        }, 150)
      }
      link.addEventListener('pointerenter', show)
      link.addEventListener('pointerleave', hide)
      // キーボードで移ったときは、名前の右寄りに出す
      link.addEventListener('focus', () => {
        const rect = link.getBoundingClientRect()
        place(rect.left + rect.width * 0.75, rect.top + rect.height / 2)
        show()
      })
      link.addEventListener('blur', hide)
    })
  }

  // 名前やポスターを押したら、板を画面いっぱいに広げながら入る（src/lib/top-enter.ts）。
  // 新しいタブで開くときと、動きを減らす設定のときはふつうに移る
  if (!prefersReducedMotion())
    document.addEventListener('click', (event) => {
      const link = (event.target as Element).closest<HTMLAnchorElement>(
        '.list .link, .list .variant-link, .picks .pick-link',
      )
      if (
        !link ||
        event.button !== 0 ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey
      )
        return
      event.preventDefault()
      const hero = document.querySelector<HTMLElement>('.hero.is-active')
      const from = link.classList.contains('pick-link')
        ? plateOf(link.querySelector('img')!, link.closest('.pick')!)
        : (hoverPlate() ??
          (hero && link.closest('.is-hero')
            ? plateOf(hero)
            : plateOf(link.querySelector('.slug') ?? link)))
      enterDemo(link.href, `/previews/${link.dataset.slug}.webp`, from)
    })
</script>

<style>
  .mark {
    position: fixed;
    top: 50%;
    left: 50%;
    margin: 0;
    font-family: "Molle Mark", cursive;
    font-size: 18vw;
    font-style: italic;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0.05;
    transform: translate(-50%, -50%);
  }

  .wrap {
    position: relative;
    padding: 25dvh 16px;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    /* h1 の太字のままだと、見えない字のために Montserrat 700 を読みに行く */
    font-weight: inherit;
    white-space: nowrap;
  }

  .lead {
    margin: 0 0 8vh;
    font-size: 12px;
    color: var(--color-muted);
    text-align: center;
    letter-spacing: 0.08em;
  }

  .lead a {
    color: inherit;
  }

  .list {
    padding: 0;
    margin: 0;
    text-align: center;
    list-style: none;
  }

  .link {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    padding-block: 0.5vh;
    color: inherit;
    text-decoration: none;
  }

  /* 線だけで描き、触れたときだけ塗る。Montserrat は字形の中で輪郭が重なっていて、線だけにすると重なりが透けるので、
     旧トップと同じく手元の Helvetica 系にする。長い slug はハイフンのところで折り返す */
  .slug {
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-size: clamp(32px, 8vw, 120px);
    font-weight: 400;
    line-height: 1.05;
    color: transparent;
    letter-spacing: -0.04em;
    -webkit-text-stroke: 1px var(--color-accent);
    transition: color 1.25s cubic-bezier(0.08, 0.82, 0.17, 1);
  }

  .title {
    font-size: 11px;
    color: var(--color-muted);
    letter-spacing: 0.1em;
    opacity: 0;
    transition: opacity 0.4s;
  }

  .link:hover .slug,
  .link:focus-visible .slug {
    color: color-mix(in oklch, var(--color-accent), white 24%);
    transition-duration: 0.2s;
  }

  .link:hover .title,
  .link:focus-visible .title {
    opacity: 1;
  }

  .link:focus-visible {
    outline: 1px solid var(--color-accent);
    outline-offset: 8px;
  }

  /* 組の行のバリエーション。名前の下に、短い呼び名を小さく並べる */
  .variants {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 16px;
    justify-content: center;
    padding: 0;
    margin: 0 0 1vh;
    list-style: none;
  }

  .variant-link {
    display: inline-block;
    padding: 2px 0;
    font-size: 12px;
    color: var(--color-muted);
    text-decoration: none;
    letter-spacing: 0.08em;
    border-bottom: 1px solid transparent;
  }

  .variant-link:hover,
  .variant-link:focus-visible {
    color: var(--color-accent);
    border-bottom-color: currentcolor;
  }

  .variant-link:focus-visible {
    outline: none;
  }

  @media (pointer: coarse) {
    .title {
      opacity: 1;
    }
  }

  /* ピックアップ。机にばらまいたポスターのように、大きさと傾きを少しずつ変えて重ねる */
  .picks {
    position: relative;
    margin: 0 auto 10vh;
  }

  .picks-title {
    position: absolute;
    top: -0.2em;
    left: max(0px, 50% - 560px);
