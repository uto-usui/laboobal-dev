---
import '@fontsource/molle/400-italic.css'
import Base from '../layouts/Base.astro'
import { getDemos } from '../lib/demos'

const demos = await getDemos()

// 仮のトップ。見た目は案を作って作者に見てもらってから決める（docs/plan.md の 3 章）
---

<Base title="labobal.dev">
  <p class="mark" aria-hidden="true">
    labobal.dev
  </p>
  <main class="wrap">
    <h1 class="title">labobal.dev</h1>
    <ul class="list">
      {demos.map((demo) => (
        <li>
          <a href={`/${demo.slug}/`}>{demo.title}</a>
          <span class="slug">/{demo.slug}/</span>
        </li>
      ))}
    </ul>
  </main>
</Base>

<style>
  .mark {
    position: fixed;
    top: 50%;
    left: 50%;
    margin: 0;
    font-family: Molle, cursive;
    font-size: 18vw;
    font-style: italic;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0.05;
    transform: translate(-50%, -50%);
  }

  .wrap {
    position: relative;
    max-width: 960px;
    padding: 64px 16px;
    margin: 0 auto;
  }

  .title {
    margin: 0 0 32px;
    font-size: 14px;
    letter-spacing: 0.1em;
  }

  .list {
    display: grid;
    gap: 12px;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .list a {
    font-size: 24px;
    font-weight: 700;
    color: inherit;
    text-decoration: none;
  }

  .list a:hover,
  .list a:focus-visible {
    color: var(--color-accent);
  }

  .slug {
    margin-left: 12px;
    font-size: 12px;
    color: var(--color-muted);
  }
</style>
