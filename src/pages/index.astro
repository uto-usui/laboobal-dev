---
import '../fonts/molle-mark.css'
import Base from '../layouts/Base.astro'
import { getDemos } from '../lib/demos'
import { compareBy, DEFAULT_SORT, SORTS, yearOf } from '../lib/top-list'

// JS がなくても初期の並び（新しい順）で出るよう、ここで並べておく
const demos = (await getDemos()).toSorted(compareBy(DEFAULT_SORT))
// 新しい順のときは、年が替わる最初の項目に年を出す
const yearFirst = new Set(
  demos
    .filter(
      (demo, i) =>
        demo.created && yearOf(demo.created) !== yearOf(demos[i - 1]?.created),
    )
    .map((demo) => demo.slug),
)

const picks = demos.filter((demo) => demo.pick)

// 何をすると動くかで絞る。meta.ts の interaction はテストでも使っていて、どのデモにも確かに入っている。pick は meta の pick
const FILTERS = [
  { key: 'all', label: 'all' },
  { key: 'pick', label: 'pick!' },
  { key: 'hover', label: 'hover' },
  { key: 'drag', label: 'drag' },
  { key: 'scroll', label: 'scroll' },
  { key: 'click', label: 'click' },
  { key: 'none', label: 'watch' },
] as const
const SPECULATION = {
  prefetch: [
    {
      where: {
        and: [
          { href_matches: '/*' },
          { selector_matches: ['.list a', '.picks a'] },
        ],
      },
      eagerness: 'moderate',
    },
  ],
}
const countOf = (key: string) =>
  key === 'all'
    ? demos.length
    : key === 'pick'
      ? picks.length
      : demos.filter((demo) => demo.interaction === key).length

// 旧トップの雰囲気（暗い背景、後ろに薄く Molle、線だけの大きな名前）を残し、locomotive をやめて素のスクロールにした案。
// 見た目は作者に見てもらってから決める（docs/plan.md の 3 章）
---

<Base title="labobal.dev">
  <!-- 名前に少しとどまったら、そのデモのページを先に取っておく。prerender は WebGL を裏で動かすことになるのでしない -->
  <script
    slot="head"
    type="speculationrules"
    is:inline
    set:html={JSON.stringify(SPECULATION)}
  />
  <p class="mark" aria-hidden="true">
    labobal.dev
  </p>
  <main class="wrap">
    <h1 class="visually-hidden">labobal.dev</h1>
    <p class="lead">
      動きの実験のデモ。説明は{' '}
      <a href="https://webmanab.com/lab/">webmanab の lab</a> に。
    </p>
    {picks.length > 0 && (
      <section class="picks" aria-labelledby="picks-title">
        <h2 id="picks-title" class="picks-title">
          pick!
        </h2>
        <ul class="pick-list">
          {picks.map((demo) => (
            <li class="pick">
              <a
                class="pick-link"
                href={`/${demo.slug}/`}
                data-slug={demo.slug}
              >
                <span class="pick-frame">
                  <img
                    src={`/previews/${demo.slug}.webp`}
                    width="480"
                    height="300"
                    alt=""
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="pick-slug">{demo.slug}</span>
                </span>
                <span class="pick-name">{demo.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
    <div class="controls">
      <nav class="filters" aria-label="何をすると動くかで絞る">
        {FILTERS.map((filter) => (
          <button
            class="filter"
            type="button"
            data-filter={filter.key}
            data-molle={filter.key === 'pick' ? '' : undefined}
            aria-pressed={filter.key === 'all' ? 'true' : 'false'}
          >
            {filter.label}
            <sup>{countOf(filter.key)}</sup>
          </button>
        ))}
      </nav>
      <nav class="sorts" aria-label="並べ方">
        {SORTS.map((sort) => (
          <button
            class="filter"
            type="button"
            data-sort={sort.key}
            aria-pressed={sort.key === DEFAULT_SORT ? 'true' : 'false'}
          >
            {sort.label}
          </button>
        ))}
      </nav>
    </div>
    <ul class="list" data-sort={DEFAULT_SORT}>
      {demos.map((demo) => (
        <li
          class="item"
          data-interaction={demo.interaction}
          data-slug={demo.slug}
          data-created={demo.created}
          data-pick={demo.pick ? '' : undefined}
          data-year-first={yearFirst.has(demo.slug) ? '' : undefined}
        >
          {demo.created && (
            <span class="year" aria-hidden="true">
              {yearOf(demo.created)}
            </span>
          )}
          <a
            class="link"
            href={`/${demo.slug}/`}
            data-slug={demo.slug}
            data-title={demo.title}
          >
            <span class="slug">{demo.slug}</span>
            {demo.pick && (
              <span class="pick-mark" aria-hidden="true">
                pick!
              </span>
            )}
            <span class="title">{demo.title}</span>
          </a>
        </li>
      ))}
    </ul>
  </main>
  <canvas class="preview-canvas" aria-hidden="true"></canvas>
  <figure class="preview" aria-hidden="true">
    <video muted loop playsinline preload="none"></video>
    <figcaption></figcaption>
  </figure>
</Base>

<script>
  import { isCoarsePointer, prefersReducedMotion } from '../shared/dom'
  import type { createGlPreview } from '../lib/top-preview'
  import {
    compareBy,
    DEFAULT_SORT,
    isSortKey,
    yearOf,
    type SortKey,
  } from '../lib/top-list'

  const list = document.querySelector<HTMLElement>('.list')!
  const items = [...list.querySelectorAll<HTMLElement>('.item')]
  const filters = [
    ...document.querySelectorAll<HTMLButtonElement>('.filters button'),
  ]
  const sorts = [
    ...document.querySelectorAll<HTMLButtonElement>('.sorts button'),
  ]

  // 絞り込みと並べ方は URL の ?filter=&sort= に残す。初期の値のときは付けない
  const params = new URLSearchParams(location.search)
  const filterParam = params.get('filter')
  const state = {
    filter: filters.some((b) => b.dataset.filter === filterParam)
      ? filterParam!
      : 'all',
    sort: isSortKey(params.get('sort')) ? params.get('sort')! : DEFAULT_SORT,
  } as { filter: string; sort: SortKey }

  const render = () => {
    items.forEach((item) => {
      item.hidden =
        state.filter === 'pick'
          ? item.dataset.pick === undefined
          : state.filter !== 'all' && item.dataset.interaction !== state.filter
    })
    // CSS の order ではなく DOM の順を替える。読み上げと Tab の順も並びに合わせるため
    const sorted = items.toSorted((a, b) =>
      compareBy(state.sort)(
        { slug: a.dataset.slug!, created: a.dataset.created },
        { slug: b.dataset.slug!, created: b.dataset.created },
      ),
    )
    if (sorted.some((item, i) => list.children[i] !== item))
      list.append(...sorted)
    list.dataset.sort = state.sort
    let year = ''
    sorted
      .filter((item) => !item.hidden)
      .forEach((item) => {
        const y = yearOf(item.dataset.created)
        item.toggleAttribute('data-year-first', y !== '' && y !== year)
        year = y
      })
    filters.forEach((b) =>
      b.setAttribute('aria-pressed', String(b.dataset.filter === state.filter)),
    )
    sorts.forEach((b) =>
      b.setAttribute('aria-pressed', String(b.dataset.sort === state.sort)),
    )
  }

  const update = (change: Partial<typeof state>) => {
    Object.assign(state, change)
    const url = new URL(location.href)
    const set = (key: string, value: string, initial: string) =>
      value === initial
        ? url.searchParams.delete(key)
        : url.searchParams.set(key, value)
    set('filter', state.filter, 'all')
    set('sort', state.sort, DEFAULT_SORT)
    history.replaceState(history.state, '', url)
    // 並びが詰まる動きは、対応するブラウザでだけ付ける
    if (document.startViewTransition && !prefersReducedMotion())
      document.startViewTransition(render)
    else render()
  }

  filters.forEach((button) =>
    button.addEventListener('click', () =>
      update({ filter: button.dataset.filter }),
    ),
  )
  sorts.forEach((button) =>
    button.addEventListener('click', () =>
      update({ sort: button.dataset.sort as SortKey }),
    ),
  )
  render()

  // ピックアップは、マウスを重ねるとポスターの上で動画を流す。動きを減らす設定のときは流さない
  if (!isCoarsePointer() && !prefersReducedMotion())
    document
      .querySelectorAll<HTMLAnchorElement>('.pick-link')
      .forEach((link) => {
        let clip: HTMLVideoElement | undefined
        link.addEventListener('pointerenter', () => {
          if (!clip) {
            clip = Object.assign(document.createElement('video'), {
              muted: true,
              loop: true,
              playsInline: true,
              src: `/previews/${link.dataset.slug}.webm`,
            })
            link.querySelector('img')!.after(clip)
          }
          clip.play().catch(() => {})
        })
        link.addEventListener('pointerleave', () => clip?.pause())
      })

  // 触れたときの動画。タッチの端末では出さない（触れた時点で開くので見る間がない）
  const preview = document.querySelector<HTMLElement>('.preview')!
  const video = preview.querySelector('video')!
  const caption = preview.querySelector('figcaption')!
  if (!isCoarsePointer()) {
    // ふだんは WebGL の板に貼って、ばねで追わせて曲げる（src/lib/top-preview.ts）。
    // 動きを減らす設定のときと WebGL が使えないときは、DOM の画像をカーソルの位置にそのまま出す
    type GlPreview = NonNullable<ReturnType<typeof createGlPreview>>
    // 使っている板。読み終えても、DOM の画像を出している間は替えない
    let gl: GlPreview | null = null
    let loaded: GlPreview | null = null
    const pointer = { x: innerWidth / 2, y: innerHeight / 2 }

    // 項目を替えたときにすぐ出せるよう、画面に入った名前のポスターだけ読んでおく
    const prefetcher = new IntersectionObserver((entries) =>
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return
        const link = entry.target as HTMLAnchorElement
        gl?.prefetch([link.dataset.slug!])
        prefetcher.unobserve(link)
      }),
    )

    const useGl = () => {
      if (!loaded || gl) return
      gl = loaded
      preview.classList.add('is-gl')
      gl.setTarget(pointer.x, pointer.y)
      list
        .querySelectorAll<HTMLAnchorElement>('.link')
        .forEach((link) => prefetcher.observe(link))
    }

    // three は大きいので、ページを開いただけでは読まない。マウスを動かすかキーボードで移ったら読み始める
    const loadGl = async () => {
      removeEventListener('pointermove', loadGl)
      removeEventListener('focusin', loadGl)
      // 読めなければ DOM の画像のまま
      const lib = await import('../lib/top-preview').catch(() => null)
      if (!lib) return
      loaded = lib.createGlPreview(
        document.querySelector<HTMLCanvasElement>('.preview-canvas')!,
        (f) => {
          // 名前の帯は板の左下の角に付いていく
          preview.style.width = `${f.width}px`
          preview.style.transform = `translate3d(${f.x}px, ${f.y}px, 0) translate(-50%, -50%) rotate(${f.tilt}rad) translate(${f.cornerX}px, ${f.cornerY}px)`
        },
        (slug) => {
          caption.textContent =
            list.querySelector<HTMLAnchorElement>(`[data-slug="${slug}"]`)
              ?.dataset.title ?? ''
        },
      )
      // DOM の画像を出している最中なら、次に項目が替わったときに板へ移る
      if (!preview.classList.contains('is-active')) useGl()
    }
    if (!prefersReducedMotion()) {
      addEventListener('pointermove', loadGl)
      addEventListener('focusin', loadGl)
    }
    let hideTimer = 0

    const place = (x: number, y: number) => {
      pointer.x = x
      pointer.y = y
      if (gl) gl.setTarget(x, y)
      else
        preview.style.transform = `translate3d(${x}px, ${y}px, 0) translate(-50%, -50%)`
    }
    addEventListener('pointermove', (event) =>
      place(event.clientX, event.clientY),
    )

    list.querySelectorAll<HTMLAnchorElement>('.link').forEach((link) => {
      const show = () => {
        clearTimeout(hideTimer)
        useGl()
        const slug = link.dataset.slug!
        if (gl) gl.show(slug)
        else {
          caption.textContent = link.dataset.title ?? ''
          video.poster = `/previews/${slug}.webp`
        }
        preview.classList.add('is-active')
      }
      // 名前と名前のすき間を通るたびに閉じると、ちらつく。少し待ち、隣に移ったら開いたまま中身だけ替える
      const hide = () => {
        hideTimer = window.setTimeout(() => {
          preview.classList.remove('is-active')
          gl?.hide()
        }, 150)
      }
      link.addEventListener('pointerenter', show)
      link.addEventListener('pointerleave', hide)
      // キーボードで移ったときは、名前の右寄りに出す
      link.addEventListener('focus', () => {
        const rect = link.getBoundingClientRect()
        place(rect.left + rect.width * 0.75, rect.top + rect.height / 2)
        show()
      })
      link.addEventListener('blur', hide)
    })
  }
</script>

<style>
  .mark {
    position: fixed;
    top: 50%;
    left: 50%;
    margin: 0;
    font-family: 'Molle Mark', cursive;
    font-size: 18vw;
    font-style: italic;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0.05;
    transform: translate(-50%, -50%);
  }

  .wrap {
    position: relative;
    padding: 25dvh 16px;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    /* h1 の太字のままだと、見えない字のために Montserrat 700 を読みに行く */
    font-weight: inherit;
    white-space: nowrap;
  }

  .lead {
    margin: 0 0 8vh;
    font-size: 12px;
    color: var(--color-muted);
    text-align: center;
    letter-spacing: 0.08em;
  }

  .lead a {
    color: inherit;
  }

  .list {
    padding: 0;
    margin: 0;
    text-align: center;
    list-style: none;
  }

  .link {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    padding-block: 0.5vh;
    color: inherit;
    text-decoration: none;
  }

  /* 線だけで描き、触れたときだけ塗る。Montserrat は字形の中で輪郭が重なっていて、線だけにすると重なりが透けるので、
     旧トップと同じく手元の Helvetica 系にする。長い slug はハイフンのところで折り返す */
  .slug {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: clamp(32px, 8vw, 120px);
    font-weight: 400;
    line-height: 1.05;
    color: transparent;
    letter-spacing: -0.04em;
    -webkit-text-stroke: 1px var(--color-accent);
    transition: color 1.25s cubic-bezier(0.08, 0.82, 0.17, 1);
  }

  .title {
    font-size: 11px;
    color: var(--color-muted);
    letter-spacing: 0.1em;
    opacity: 0;
    transition: opacity 0.4s;
  }

  .link:hover .slug,
  .link:focus-visible .slug {
    color: color-mix(in oklch, var(--color-accent), white 24%);
    transition-duration: 0.2s;
  }

  .link:hover .title,
  .link:focus-visible .title {
    opacity: 1;
  }

  .link:focus-visible {
    outline: 1px solid var(--color-accent);
    outline-offset: 8px;
  }

  @media (pointer: coarse) {
    .title {
      opacity: 1;
    }
  }

  /* ピックアップ。机にばらまいたポスターのように、大きさと傾きを少しずつ変えて重ねる */
  .picks {
    position: relative;
    margin: 0 auto 10vh;
  }

  .picks-title {
    position: absolute;
    top: -0.2em;
    left: max(0px, 50% - 560px);
    z-index: 3;
    margin: 0;
    font-family: 'Molle Mark', cursive;
    font-size: clamp(44px, 7vw, 96px);
    font-style: italic;
    font-weight: 400;
    line-height: 1;
    color: var(--color-accent);
    pointer-events: none;
    transform: rotate(-12deg);
  }

  .pick-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    max-width: 1180px;
    padding: 0;
    margin: 0 auto;
    list-style: none;
  }

  .pick {
    --w: 22vw;
    --r: -4deg;
    --y: 0px;

    width: min(var(--w), 300px);
    margin: 0 -10px 56px;
    transform: translateY(var(--y)) rotate(var(--r));
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .pick:nth-child(8n + 2) {
    --w: 18vw;
    --r: 5deg;
    --y: 36px;
  }

  .pick:nth-child(8n + 3) {
    --w: 21vw;
    --r: -2deg;
    --y: -8px;
  }

  .pick:nth-child(8n + 4) {
    --w: 17vw;
    --r: 7deg;
    --y: 28px;
  }

  .pick:nth-child(8n + 5) {
    --w: 20vw;
    --r: 3deg;
    --y: -14px;
  }

  .pick:nth-child(8n + 6) {
    --w: 23vw;
    --r: -6deg;
    --y: 40px;
  }

  .pick:nth-child(8n + 7) {
    --w: 18vw;
    --r: 4deg;
    --y: 6px;
  }

  .pick:nth-child(8n + 8) {
    --w: 20vw;
    --r: -3deg;
    --y: 30px;
  }

  .pick:has(.pick-link:hover, .pick-link:focus-visible) {
    position: relative;
    z-index: 2;
    transform: translateY(var(--y)) rotate(0deg) scale(1.08);
    transition-duration: 0.25s;
  }

  .pick-link {
    position: relative;
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .pick-frame {
    position: relative;
    display: block;
  }

  /* 動画はあとから JS で足すので、scoped の印が付かない。:global で拾う */
  .pick-link img,
  .pick-link :global(video) {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    background: #111;
    box-shadow: 0 18px 40px rgb(0 0 0 / 0.45);
  }

  .pick-link :global(video) {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    opacity: 0;
  }

  .pick-link:hover :global(video) {
    opacity: 1;
  }

  /* 名前はポスターの下の縁にまたがせる */
  .pick-slug {
    position: absolute;
    bottom: 0;
    left: -6px;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: clamp(20px, 2.4vw, 34px);
    line-height: 1;
    color: transparent;
    letter-spacing: -0.04em;
    white-space: nowrap;
    -webkit-text-stroke: 1px #fff;
    transform: translateY(45%);
    transition: color 0.4s;
  }

  .pick-link:hover .pick-slug,
  .pick-link:focus-visible .pick-slug {
    color: var(--color-accent);
    -webkit-text-stroke-color: var(--color-accent);
  }

  .pick-name {
    display: block;
    margin-top: 30px;
    font-size: 11px;
    color: var(--color-muted);
    letter-spacing: 0.08em;
  }

  .pick-link:focus-visible {
    outline: 1px solid var(--color-accent);
    outline-offset: 6px;
  }

  /* スマホでは横に流す 1 列にする */
  @media (width < 640px) {
    .picks {
      margin-inline: -16px;
    }

    .picks-title {
      left: 12px;
    }

    .pick-list {
      flex-wrap: nowrap;
      justify-content: flex-start;
      padding: 48px 16px 24px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .pick,
    .pick:nth-child(n) {
      --w: 64vw;

      flex: none;
      margin: 0 -4px 0 0;
      scroll-snap-align: center;
    }
  }

  /* 一覧の名前の右肩の印 */
  .link {
    position: relative;
  }

  .pick-mark {
    position: absolute;
    top: 0;
    right: 0;
    font-family: 'Molle Mark', cursive;
    font-size: clamp(14px, 2vw, 24px);
    font-style: italic;
    color: var(--color-accent);
    pointer-events: none;
    transform: translate(70%, -10%) rotate(-14deg);
  }

  .filter[data-molle] {
    font-family: 'Molle Mark', cursive;
    font-size: 15px;
    font-style: italic;
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
    align-items: center;
    justify-content: center;
    margin: 0 0 6vh;
  }

  .filters,
  .sorts {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
    justify-content: center;
  }

  /* 絞り込みと並べ方の間に斜めの線を 1 本 */
  .sorts::before {
    font-size: 12px;
    color: var(--color-muted);
    content: '/';
  }

  /* 狭い画面では並べ方が次の行に回るので、線は要らない */
  @media (width < 640px) {
    .sorts::before {
      content: none;
    }
  }

  .filter {
    padding: 4px 0;
    font: inherit;
    font-size: 12px;
    color: var(--color-muted);
    letter-spacing: 0.08em;
    cursor: pointer;
    background: none;
    border: 0;
    border-bottom: 1px solid transparent;
  }

  .filter[aria-pressed='true'] {
    color: var(--color-accent);
    border-bottom-color: currentcolor;
  }

  .filter sup {
    margin-left: 2px;
    font-size: 9px;
  }

  .item {
    view-transition-name: match-element;
  }

  /* 新しい順のときだけ、年が替わるところに小さく年を出す */
  .year {
    display: none;
    margin: 6vh 0 1vh;
    font-size: 11px;
    color: var(--color-accent);
    letter-spacing: 0.4em;
  }

  .list[data-sort='new'] .item[data-year-first] .year {
    display: block;
  }

  .list[data-sort='new'] .item[data-year-first]:first-child .year {
    margin-top: 0;
  }

