---
import Base from '../../layouts/Base.astro'
import { getDemos } from '../../lib/demos'
import { byAdded } from '../../lib/feeds'

// labobal.dev に置いた日ごとにまとめる。日のないものは最後に「—」でまとめる
const groups = new Map<string, Awaited<ReturnType<typeof getDemos>>>()
for (const demo of byAdded(await getDemos())) {
  const key = demo.added ?? '—'
  groups.set(key, [...(groups.get(key) ?? []), demo])
}
---

<Base title="log | labobal.dev" description="labobal.dev に置いたデモの記録">
  <main class="wrap">
    <h1 class="heading">log</h1>
    <p class="lead">
      置いたデモを新しい順に。<a href="/rss.xml">RSS</a> / <a href="/">top</a>
    </p>
    {[...groups].map(([date, demos]) => (
      <section class="day">
        <h2 class="date">
          {date === '—' ? date : <time datetime={date}>{date}</time>}
        </h2>
        <ul class="list">
          {demos.map((demo) => (
            <li>
              <a class="link" href={`/${demo.slug}/`}>
                <span class="slug">{demo.slug}</span>
                <span class="title">{demo.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </main>
</Base>

<style>
  .wrap {
    max-width: 960px;
    padding: 12dvh 16px;
    margin: 0 auto;
  }

  /* トップの名前と同じく線だけで描く（src/pages/index.astro の .slug） */
  .heading {
    margin: 0;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: clamp(64px, 16vw, 200px);
    font-weight: 400;
    line-height: 1;
    color: transparent;
    letter-spacing: -0.04em;
    -webkit-text-stroke: 1px var(--color-accent);
  }

  .lead {
    /* 見出しの「g」の下が文に触れないよう空ける */
    margin: 40px 0 8vh;
    font-size: 12px;
    color: var(--color-muted);
    letter-spacing: 0.08em;
  }

  .lead a {
    color: inherit;
  }

  .day {
    display: grid;
    grid-template-columns: 7em 1fr;
    gap: 0 24px;
    padding: 16px 0;
    border-top: 1px solid
      color-mix(in srgb, var(--color-muted) 40%, transparent);
  }

  .date {
    margin: 0;
    font-size: 12px;
    font-weight: 400;
    font-variant-numeric: tabular-nums;
    color: var(--color-muted);
    letter-spacing: 0.08em;
  }

  .list {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .link {
    display: flex;
    flex-wrap: wrap;
    gap: 0 12px;
    align-items: baseline;
    padding: 2px 0;
    color: inherit;
    text-decoration: none;
  }

  .slug {
    font-size: 15px;
    color: var(--color-accent);
  }

  .title {
    font-size: 11px;
    color: var(--color-muted);
    letter-spacing: 0.08em;
  }

  .link:hover .slug,
  .link:focus-visible .slug {
    text-decoration: underline;
  }

  @media (width < 560px) {
    .day {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }
</style>
