---
// 4 本に共通の、もとの fiddle の見た目（見出し、説明、点線の枠の canvas）。説明は slot に入れる
interface Props {
  /** 大きな見出し（fiddle の題名） */
  title: string
}

const { title } = Astro.props
---

<div class="fiddle">
  <h1>{title}</h1>
  <p><slot /></p>
  <div class="frame">
    <canvas data-fiddle-canvas></canvas>
  </div>
</div>

<style>
  .fiddle {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 16px;
    font-family: Helvetica, Arial, sans-serif;
    color: #000;
    text-align: center;
    color-scheme: light;
    background: linear-gradient(-30deg, #f7cac9 20%, #91a8d0 85%);
    container-type: size;
  }

  h1 {
    margin: 0;
    font-size: clamp(24px, 9cqh, 42px);
    font-weight: bold;
    line-height: 1.1;
    color: #32355a;
  }

  p {
    margin: 4px 0 0;
    font-size: clamp(12px, 3.6cqh, 16px);
    line-height: 1.4;
  }

  .frame {
    display: grid;
    flex: 1 1 0;
    place-items: center;
    align-self: stretch;
    min-height: 0;
    margin-top: 8px;
  }

  /* border だと canvas の大きさに入って座標がずれるので、外側に outline で描く */
  canvas {
    display: block;
    outline: 3px dashed rgb(50 53 90 / 55%);
    background-color: rgb(255 255 255 / 15%);
  }
</style>
