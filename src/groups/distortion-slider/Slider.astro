---
// 4 本に共通の入れ物と番号。canvas は slider.ts が足す
---

<div class="slider">
  <nav class="bullets" aria-hidden="true">
    {['01', '02', '03'].map((n) => (
      <div class="bullet">
        <span class="bullet-text">{n}</span>
        <span class="bullet-line" />
      </div>
    ))}
  </nav>
</div>

<style>
  .slider {
    position: absolute;
    inset: 0;
    overflow: hidden;
    cursor: pointer;
    background: #111;
  }

  .slider :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* 明るい写真の上でも読めるよう、写真との差で色を出す */
  .bullets {
    position: absolute;
    top: 50%;
    right: 0;
    translate: 0 -50%;
    mix-blend-mode: difference;
  }

  .bullet {
    display: flex;
    align-items: center;
    padding: 1rem 0;
  }

  .bullet-text {
    margin-right: 1rem;
    font-size: 0.65rem;
    color: #fff;
  }

  .bullet-line {
    width: 1rem;
    height: 1px;
    background: #fff;
  }
</style>
