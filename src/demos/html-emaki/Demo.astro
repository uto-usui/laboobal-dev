<style>
  .stage {
    position: absolute;
    inset: 0;
    overflow: hidden;
    cursor: grab;
    /* 緋毛氈を敷いた机 */
    background:
      radial-gradient(
        ellipse at 50% 40%,
        rgb(255 255 255 / 0.06),
        transparent 70%
      ),
      #4f2120;
    /* 記事を読む人の縦のスクロールを奪わない。タップすると touchGate が none にする */
    touch-action: pan-y;
  }

  .stage.is-grabbing {
    cursor: grabbing;
  }

  .view {
    display: block;
    width: 100%;
    height: 100%;
  }

  .sheet {
    --paper: #efe6d2;
    --ink: #2e2620;
    position: relative;
    box-sizing: border-box;
    width: 900px;
    height: 360px;
    overflow: hidden;
    color: var(--ink);
    font-family: "Hiragino Mincho ProN", "Yu Mincho", YuMincho, serif;
    color-scheme: light;
    background: var(--paper);
    user-select: none;
  }

  /* 巻きの奥に入った紙は動かさない（main.ts） */
  .sheet.is-rolled,
  .sheet.is-rolled * {
    animation-play-state: paused !important;
  }

  .defs {
    position: absolute;
  }

  .art {
    filter: url(#emaki-paint);
  }

  .art,
  .glow {
    position: absolute;
    inset: 0;
    width: 900px;
    height: 360px;
    max-width: none;
  }

  .ink {
    stroke: #3b3027;
    stroke-width: 1.2;
    stroke-linejoin: round;
  }

  .ink :is(path, rect, ellipse, circle):not([stroke]) {
    stroke: #3b3027;
    stroke-width: 1.2;
  }

  .bank {
    fill: #c6cd9f;
    opacity: 0.85;
  }

  .far {
    fill: #d3c495;
  }

  .wash {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* 時刻の色。隣の紙と継ぎ目で同じ色になるように、右の端と左の端の色を合わせる */
  .s0 .wash {
    background: linear-gradient(
      to left,
      transparent 30%,
      rgb(232 190 182 / 0.3)
    );
  }

  .s1 .wash {
    background: linear-gradient(
      to left,
      rgb(232 190 182 / 0.3),
      rgb(200 215 225 / 0.22)
    );
  }

  .s2 .wash {
    background: linear-gradient(
      to left,
      rgb(200 215 225 / 0.22),
      rgb(240 230 200 / 0.08)
    );
  }

  .s3 .wash {
    background: linear-gradient(
      to left,
      rgb(240 230 200 / 0.08),
      rgb(240 220 170 / 0.15)
    );
  }

  .s4 .wash {
    background: linear-gradient(
      to left,
      rgb(240 220 170 / 0.15),
      rgb(150 160 165 / 0.32)
    );
  }

  .s5 .wash {
    background: linear-gradient(
      to left,
      rgb(150 160 165 / 0.32),
      rgb(150 150 160 / 0.3) 35%,
      rgb(205 120 90 / 0.42)
    );
  }

  .s6 .wash {
    background: linear-gradient(
      to left,
      rgb(205 120 90 / 0.42),
      rgb(28 34 62 / 0.9) 45%,
      rgb(22 27 50 / 0.94)
    );
  }

  .s7 .wash {
    background: linear-gradient(
      to left,
      rgb(22 27 50 / 0.94),
      rgb(22 27 50 / 0.94) 45%,
      rgb(22 27 50 / 0) 60%
    );
  }

  .kotoba {
    position: absolute;
    top: 24px;
    right: 26px;
    height: 206px;
    margin: 0;
    font-size: 14px;
    line-height: 1.95;
    letter-spacing: 0.06em;
    writing-mode: vertical-rl;
  }

  .kotoba h2 {
    margin: 0 0 0 10px;
    font-size: 17px;
    font-weight: 600;
    letter-spacing: 0.2em;
  }

  .kotoba p {
    margin: 0 0 0 4px;
  }

  .night .kotoba {
    color: #e6cd86;
  }

  /* 表紙と見返し */
  .cover {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 172px;
    background:
      radial-gradient(circle, #c9a85a 1.1px, transparent 1.6px) 0 0 / 14px 14px,
      radial-gradient(circle, #a8893f 0.9px, transparent 1.3px) 7px 7px / 14px
      14px,
      linear-gradient(90deg, #1d2541, #2a3557 50%, #1d2541);
    box-shadow: inset 6px 0 10px rgb(0 0 0 / 0.35);
  }

  .slip {
    position: absolute;
    top: 22px;
    left: 18px;
    margin: 0;
    padding: 12px 6px;
    color: #2e2620;
    font-size: 17px;
    letter-spacing: 0.3em;
    writing-mode: vertical-rl;
    background:
      radial-gradient(circle, #d8b860 0.8px, transparent 1.2px) 0 0 / 7px 9px,
      #f3ecd8;
    border: 1px solid #b89a52;
  }

  .endpaper {
    position: absolute;
    top: 0;
    right: 172px;
    bottom: 0;
    width: 100px;
    background:
      radial-gradient(circle, #d6b45a 0.9px, transparent 1.4px) 0 0 / 9px 11px,
      radial-gradient(circle, #e3c776 1.2px, transparent 1.8px) 4px 5px / 23px
      19px,
      #e9dcc0;
  }

  .prologue {
    right: 300px;
    height: 296px;
  }

  /* 市の灯籠 */
  .lanterns {
    position: absolute;
    top: 104px;
    left: 458px;
    display: flex;
    gap: 14px;
  }

  .lantern {
    display: grid;
    justify-items: center;
    gap: 3px;
    width: 34px;
    cursor: pointer;
  }

  .lantern .cord {
    width: 1px;
    height: 8px;
    background: #3b3027;
  }

  .lantern .body {
    position: relative;
    width: 28px;
    height: 36px;
    background: color-mix(in srgb, var(--c) 55%, #8d8273);
    border-top: 4px solid #3b3027;
    border-bottom: 4px solid #3b3027;
    border-radius: 10px / 13px;
  }

  .lantern .flame {
    position: absolute;
    inset: 9px 9px;
    border-radius: 50%;
    opacity: 0;
    background: radial-gradient(#fff8d0, transparent 70%);
  }

  .lantern:has(input:checked) .body {
    background: radial-gradient(circle at 50% 55%, #fff6c8, var(--c) 70%);
    box-shadow: 0 0 16px 4px color-mix(in srgb, var(--c) 70%, transparent);
  }

  .lantern:has(input:checked) .flame {
    opacity: 1;
  }

  .lantern .name {
    font-size: 11px;
    line-height: 1.2;
    writing-mode: vertical-rl;
    min-height: 3.6em;
  }

  .lantern input {
    margin: 0;
    accent-color: #8a3b2b;
  }

  .lantern:focus-within .body {
    outline: 2px solid #8a3b2b;
    outline-offset: 2px;
  }

  /* 渡し */
  .boat {
    position: absolute;
    top: 240px;
    left: 370px;
    width: 130px;
    transition: transform 1.2s cubic-bezier(0.45, 0, 0.3, 1);
  }

  .boat svg {
    width: 130px;
    height: 60px;
  }

  .cargo {
    position: absolute;
    top: 28px;
    left: 14px;
    display: flex;
    gap: 4px;
  }

  .mini {
    display: none;
    width: 9px;
    height: 12px;
    background: radial-gradient(circle at 50% 55%, #fff6c8, var(--c) 75%);
    border-top: 2px solid #3b3027;
    border-radius: 4px / 5px;
    box-shadow: 0 0 8px 2px color-mix(in srgb, var(--c) 60%, transparent);
  }

  .view:has(#bank-far:checked) .boat {
    transform: translate(10px, -50px) scale(0.92);
  }

  .banks {
    position: absolute;
    top: 30px;
    right: 262px;
    display: flex;
    flex-direction: row-reverse;
    gap: 8px;
    margin: 0;
    padding: 10px 8px;
    font-size: 13px;
    background: rgb(250 245 232 / 0.7);
    border: 1px solid #b89a52;
  }

  .banks legend {
    padding: 0 4px;
    color: #8a3b2b;
    font-size: 11px;
  }

  .banks label {
    display: flex;
    flex-direction: column;
    gap: 6px;
    align-items: center;
    cursor: pointer;
  }

  .banks span {
    writing-mode: vertical-rl;
    letter-spacing: 0.08em;
  }

  .banks input {
    margin: 0;
    accent-color: #8a3b2b;
  }

  .far-only {
    display: none;
  }

  .view:has(#bank-far:checked) .near-only {
    display: none;
  }

  .view:has(#bank-far:checked) .far-only {
    display: inline;
  }

  .view:has(#lan-1:checked) .lan-1,
  .view:has(#lan-2:checked) .lan-2,
  .view:has(#lan-3:checked) .lan-3,
  .view:has(#lan-4:checked) .lan-4,
  .view:has(#lan-5:checked) .lan-5 {
    display: block;
  }

  /* 夕立。模様の 1 つぶん（80px）下げてくり返す */
  .rainfall {
    animation: emaki-rain 0.6s linear infinite;
  }

  @keyframes emaki-rain {
    to {
      translate: 0 80px;
    }
  }

  /* 灯籠流し */
  .floats {
    position: absolute;
    inset: 0;
  }

  .float {
    position: absolute;
    top: 276px;
    display: none;
    width: 14px;
    height: 14px;
    background: radial-gradient(circle at 50% 55%, #fffbe0, var(--c) 70%);
    border-top: 2px solid #1a1410;
    border-radius: 3px;
    box-shadow:
      0 0 14px 5px color-mix(in srgb, var(--c) 65%, transparent),
      0 0 40px 10px color-mix(in srgb, var(--c) 30%, transparent);
    animation: emaki-bob 3.2s ease-in-out var(--d) infinite alternate;
  }

  /* 水に映る灯り */
  .float::after {
    position: absolute;
    top: 16px;
    left: 2px;
    width: 10px;
    height: 26px;
    content: "";
    background: linear-gradient(
      color-mix(in srgb, var(--c) 80%, transparent),
      transparent
    );
    filter: blur(2px);
    opacity: 0.7;
  }

  .view:has(#bank-far:checked) .float {
    top: 252px;
  }

  @keyframes emaki-bob {
    to {
      translate: -6px 2px;
    }
  }

  .crowd {
    position: absolute;
    left: 110px;
    width: 160px;
    height: 24px;
  }

  .crowd.near-only {
    top: 302px;
  }

  .crowd.far-only {
    top: 218px;
  }

  .view:has(#bank-far:checked) .crowd.far-only {
    display: block;
  }

  .some-only {
    display: none;
  }

  .view:has(.lantern input:checked) .some-only {
    display: block;
  }

  .view:has(.lantern input:checked) .none-only {
    display: none;
  }

  /* 海と奥書 */
  .dot {
    position: absolute;
    display: none;
    width: 4px;
    height: 4px;
    background: var(--c);
    border-radius: 50%;
    box-shadow: 0 0 8px 3px color-mix(in srgb, var(--c) 60%, transparent);
  }

  .kotoba.sea {
    right: 40px;
    height: 180px;
  }

  .colophon {
    top: 34px;
    right: 600px;
    height: 280px;
    color: var(--ink);
    font-size: 14px;
  }

  .night .colophon {
    color: var(--ink);
  }

  .colophon .title {
    font-size: 17px;
    letter-spacing: 0.2em;
  }

  .colophon .sign {
    margin-top: 120px;
    font-family: Georgia, serif;
    font-size: 12px;
    letter-spacing: 0.1em;
  }

  .seal {
    display: block;
    width: 30px;
    height: 30px;
    margin-top: 10px;
    color: #f6e9e0;
    font-size: 19px;
    line-height: 30px;
    text-align: center;
    background: #b8392a;
    border-radius: 3px;
    writing-mode: horizontal-tb;
  }

  /* 水と水車と霧 */
  .flow {
    stroke-width: 0.9;
    stroke-opacity: 0.55;
    stroke-dasharray: 3 9 16 12;
    animation: emaki-flow 2.6s linear infinite;
  }

  @keyframes emaki-flow {
    to {
      stroke-dashoffset: -60;
    }
  }

  .wheel {
    transform-box: fill-box;
    transform-origin: center;
    animation: emaki-spin 9s linear infinite reverse;
  }

  @keyframes emaki-spin {
