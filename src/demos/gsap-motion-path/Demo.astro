---
const d =
  'M9,100c0,0,18.53-41.58,49.91-65.11c30-22.5,65.81-24.88,77.39-24.88c33.87,0,57.55,11.71,77.05,28.47c23.09,19.85,40.33,46.79,61.71,69.77c24.09,25.89,53.44,46.75,102.37,46.75c22.23,0,40.62-2.83,55.84-7.43c27.97-8.45,44.21-22.88,54.78-36.7c14.35-18.75,16.43-36.37,16.43-36.37'
---

<div class="stage">
  <svg viewBox="-20 -20 557 230" aria-hidden="true">
    <path class="path" d={d} data-path></path>
    <path
      class="trail"
      d={d}
      pathLength="100"
      stroke-dasharray="100"
      stroke-dashoffset="100"
      data-trail
    ></path>
    <rect
      class="mover"
      x="-8"
      y="-3.5"
      width="16"
      height="7"
      rx="3.5"
      data-mover
    ></rect>
  </svg>
</div>

<script>
  import './main'
</script>

<style>
  .stage {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: #f1f1f1;
  }

  svg {
    width: 100%;
    height: 100%;
  }

  .path,
  .trail {
    fill: none;
    stroke-linecap: round;
  }

  .path {
    stroke: #c4c4c4;
    stroke-width: 1.5;
  }

  .trail {
    stroke: #25ecb7;
    stroke-width: 2.5;
  }

  .mover {
    fill: #0f9e7a;
  }
</style>
