---
import '@fontsource/molle/400-italic.css'

const heads = ['titleA', 'titleB', 'titleC', 'titleD']
const rows = ['a', 'b', 'c', 'd'].map((row) =>
  [1, 2, 3, 4].map((col) => `${row}0${col}`),
)
---

<div class="flex-table">
  <h1>Responsive Table</h1>
  <table>
    <thead>
      <tr>
        {heads.map((head) => <th>{head}</th>)}
      </tr>
    </thead>
    <tbody>
      {rows.map((cells) => (
        <tr>
          {cells.map((cell) => (
            <td>{cell}</td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .flex-table {
    display: flex;
    flex-direction: column;
    gap: 32px;
    align-items: center;
    min-height: 100dvh;
    padding: 48px 16px 150px;
    color: #292b2c;
    color-scheme: light;
    background-image: linear-gradient(45deg, #f7cac9 15%, #91a8d0 85%);
  }

  h1 {
    margin: 0;
    font-family: Molle, cursive;
    font-size: 40px;
    font-style: italic;
    font-weight: 400;
    color: rgb(255 255 255 / 85%);
  }

  table {
    font-size: 14px;
    border-collapse: collapse;
  }

  th,
  td {
    padding: 12px;
    text-align: left;
    border-top: 1px solid #eceeef;
  }

  thead {
    background-color: rgb(0 0 0 / 10%);
  }

  tbody {
    background-color: rgb(255 255 255 / 35%);
  }

  /*
   * 広い画面では、表の部品をすべて flex の箱にして、tr を縦に積む。
   * 行だった tr が列になるので、見出しが左の 1 列にまとまり、行と列が入れ替わる
   */
  @media (width >= 769px) {
    table,
    tbody {
      display: flex;
    }

    tr {
      display: flex;
      flex-direction: column;
    }

    th,
    td {
      border-top: 0;
    }
  }
</style>
