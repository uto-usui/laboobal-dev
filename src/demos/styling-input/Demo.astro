---
import '@fontsource/molle/400-italic.css'
---

<div class="wave-input">
  <h1>my input</h1>
  <form class="fields">
    <input type="text" placeholder="name" aria-label="名前" />
    <input type="tel" placeholder="tel" aria-label="電話番号" />
  </form>
</div>

<style>
  .wave-input {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    gap: 48px;
    align-items: center;
    justify-content: center;
    padding: 16px;
    color-scheme: light;
    background-image: linear-gradient(45deg, #f7cac9 15%, #91a8d0 85%);
  }

  h1 {
    margin: 0;
    font-family: Molle, cursive;
    font-size: 40px;
    font-style: italic;
    font-weight: 400;
    color: rgb(255 255 255 / 85%);
  }

  .fields {
    display: flex;
    flex-direction: column;
    gap: 32px;
    width: min(300px, 100%);
  }

  /* 波を 1 つ分だけ描いた 18 × 10 の画像を横に並べ、画像 1 枚分ずつ横へずらし続ける */
  @keyframes wave {
    from {
      background-position: 0 bottom;
    }

    to {
      background-position: 18px bottom;
    }
  }

  input {
    width: 100%;
    padding: 0 0 0.5em;
    font-family: Molle, cursive;
    font-size: 32px;
    font-style: italic;
    color: rgb(255 255 255 / 90%);
    letter-spacing: 0.05em;
    background: url('data:image/png;base64,')
      repeat-x 0 bottom;
    border: 0;
    outline: 0;
    animation: wave 0.4s linear infinite;
  }

  /* 書いている間は波を止める。止まった線が「ここに書いている」の目じるしになる */
  input:focus {
    animation: none;
  }

  input::placeholder {
    font-family: system-ui, sans-serif;
    font-style: normal;
    font-weight: 600;
    color: rgb(255 255 255 / 60%);
    text-transform: uppercase;
  }

  @media (prefers-reduced-motion: reduce) {
    input {
      animation: none;
    }
  }
</style>
