---
const faces = ['bottom', 'top', 'back', 'right', 'left', 'front']
---

<div class="stage">
  <ul class="wrap">
    {[0, 1, 2].map(() => (
      <li class="box">
        <div class="cube">
          {faces.map((face) => (
            <div class={`face ${face}`}>{face.toUpperCase()}</div>
          ))}
        </div>
      </li>
    ))}
  </ul>
</div>

<style>
  .stage {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: #fff;
  }

  .wrap {
    display: flex;
    justify-content: space-around;
    width: min(600px, 100%);
    padding: 0;
    margin: 0;
    list-style: none;
    perspective: 400px;
  }

  .box {
    width: 100px;
    height: 100px;
  }

  .cube {
    position: relative;
    width: 100px;
    height: 100px;
    margin: 0 auto;
    cursor: pointer;
    transform-style: preserve-3d;
    transition: transform 2s;
  }

  /* 手前に 200px 出てきながら、縦と奥行きの軸で 1 回ずつ回る。マウスを外すと逆にたどって戻る */
  .cube:hover {
    transform: translate3d(0, 0, 200px) rotateY(360deg) rotateZ(360deg);
  }

  .face {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100px;
    height: 100px;
    font-size: 14px;
    color: #fff;
    background: hsl(217deg 62% 71% / 60%);
  }

  /* 6 枚の正方形を、立方体の面の位置へ倒したり押し出したりする。上と下は色を変える */
  .top {
    top: -50px;
    left: 0;
    background: hsl(357deg 45% 91%);
    transform: rotateX(90deg);
  }

  .bottom {
    bottom: -50px;
    left: 0;
    background: hsl(357deg 45% 91%);
    transform: rotateX(-90deg);
  }

  .front {
    top: 0;
    left: 0;
    transform: translateZ(50px);
  }

  .back {
    top: 0;
    left: 0;
    transform: translateZ(-50px);
  }

  .right {
    top: 0;
    right: -50px;
    transform: rotateY(90deg);
  }

  .left {
    top: 0;
    left: -50px;
    transform: rotateY(-90deg);
  }
</style>
