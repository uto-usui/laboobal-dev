---
import { Picture } from 'astro:assets'
import photo from './assets/photo.jpg'
---

<div class="stage">
  <Picture
    class="photo"
    src={photo}
    formats={['avif']}
    fallbackFormat="webp"
    loading="eager"
    alt=""
  />
</div>

<script>
  import { start } from '../../shared/variants'
  import * as variant from './main'
  start(variant)
</script>

<style>
  .stage {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    container-type: size;
    overflow: hidden;
    /* 記事に埋め込んだとき、縦に指を動かせば記事がスクロールするようにする。横の動きはデモが受け取る */
    touch-action: pan-y;
  }

  /* 入れ物の幅の 80% と高さの 80% の、どちらにも収まる 16:9 */
  .photo {
    width: min(80cqw, 80cqh * 16 / 9);
    /* Picture が付ける height の属性より、縦横比を優先する */
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    pointer-events: none;
  }
</style>
