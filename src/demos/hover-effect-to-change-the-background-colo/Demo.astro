---
import '@fontsource/molle/400-italic.css'
---

<div class="two-step">
  <h1>block animation</h1>
  <section class="frame">
    <a class="block" href="#">
      <span>HOVER</span>
    </a>
  </section>
</div>

<script>
  // 押してもどこへも行かない。キーボードで focus したときにも同じ動きを見せるために a にしている
  document
    .querySelector('.two-step .block')!
    .addEventListener('click', (event) => event.preventDefault())
</script>

<style>
  .two-step {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
    align-items: center;
    justify-content: center;
    padding: 16px;
    color: #232931;
    color-scheme: light;
    background-image: linear-gradient(60deg, #f7cac9 15%, #91a8d0 85%);
    container-type: size;
  }

  h1 {
    margin: 0;
    font-family: Molle, cursive;
    font-size: clamp(28px, 7cqh, 48px);
    font-style: italic;
    font-weight: 400;
    color: rgb(255 255 255 / 85%);
  }

  .frame {
    padding: 16px;
    border: 6px double currentcolor;
  }

  .block {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: min(300px, 60cqh);
    aspect-ratio: 1;
    overflow: hidden;
    font-size: 32px;
    color: inherit;
    text-decoration: none;
    background-color: rgb(255 255 255 / 35%);
    outline-offset: 4px;
    transition: 0.4s 0.25s ease-out;
  }

  /* 下から伸びる 2 枚の色の板。下端を軸に、高さ 0 から 1 へ伸ばす */
  .block::before,
  .block::after {
    position: absolute;
    inset: 0;
    pointer-events: none;
    content: '';
    transform: scaleY(0);
    transform-origin: bottom;
  }

  /*
   * 外れたときの順。手前の金色が先に縮み、0.25 秒遅れて奥の青緑が縮む。
   * 乗ったときは下の :hover で遅らせる側を入れ替えて、青緑、金色の順に伸ばす
   */
  .block::after {
    z-index: 1;
    background: #00889b;
    transition: transform 0.25s 0.25s ease-in;
  }

  .block::before {
    z-index: 2;
    background: #ca7;
    transition: transform 0.25s ease-in;
  }

  .block > span {
    position: relative;
    z-index: 3;
  }

  .block:is(:hover, :focus-visible) {
    font-size: 25vw;
    color: #fff;
    letter-spacing: 0.1em;
  }

  .block:is(:hover, :focus-visible)::after {
    transform: scaleY(1);
    transition: transform 0.25s ease-out;
  }

  .block:is(:hover, :focus-visible)::before {
    transform: scaleY(1);
    transition: transform 0.25s 0.25s ease-out;
  }
</style>
