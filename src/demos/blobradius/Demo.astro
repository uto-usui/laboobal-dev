<div class="blobradius">
  <div class="blob blob--left"></div>
  <div class="blob blob--right"></div>
</div>

<style>
  .blobradius {
    position: absolute;
    inset: 0;
    overflow: clip;
    container-type: size;
  }

  .blob {
    --size: min(30cqw, 60cqh);

    position: absolute;
    top: calc(50% - var(--size) / 2);
    width: var(--size);
    height: var(--size);
    background-image: linear-gradient(
      var(--color-accent),
      rgb(from var(--color-accent) r g b / 10%)
    );
    opacity: 0.8;
  }

  /* 形は同じ keyframes を、左は順に、右は逆から再生する。周期が 30 秒と長いので、変わっていくのにほとんど気づかない */
  .blob--left {
    left: 10cqw;
    animation: radius 30s ease-in-out infinite both alternate;
  }

  .blob--right {
    right: 10cqw;
    animation:
      radius 30s ease-in-out infinite both alternate-reverse,
      drift 20s ease-in-out infinite both;
  }

  @media (prefers-reduced-motion: reduce) {
    .blob {
      animation-play-state: paused;
    }
  }

  /* 8 つの値で四隅の楕円を別々に決める。前半 4 つが横の半径、/ の後ろが縦の半径 */
  @keyframes radius {
    0%,
    100% {
      border-radius: 33% 67% 70% 30% / 30% 30% 70% 70%;
    }

    10% {
      border-radius: 37% 63% 51% 49% / 37% 65% 35% 63%;
    }

    20% {
      border-radius: 36% 64% 64% 36% / 64% 48% 52% 36%;
    }

    30% {
      border-radius: 37% 63% 51% 49% / 30% 30% 70% 70%;
    }

    40% {
      border-radius: 40% 60% 42% 58% / 41% 51% 49% 59%;
    }

    50% {
      border-radius: 50% 50% 22% 78% / 36% 29% 71% 64%;
    }

    60% {
      border-radius: 64% 36% 78% 22% / 56% 33% 67% 44%;
    }

    70% {
      border-radius: 39% 61% 33% 67% / 70% 67% 33% 30%;
    }

    80% {
      border-radius: 73% 27% 79% 21% / 37% 40% 60% 63%;
    }

    90% {
      border-radius: 40% 60% 42% 58% / 41% 51% 49% 59%;
    }
  }

  @keyframes drift {
    0%,
    100% {
      transform: none;
    }

    50% {
      transform: translate(50%, 20%) rotate(-200deg) scale(1.2);
    }
  }
</style>
