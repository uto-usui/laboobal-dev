---
import photo from './assets/photo.jpg'
import { getImage } from 'astro:assets'

// CSS の background に敷くので、Picture の代わりに WebP だけを作る
const background = await getImage({ src: photo, format: 'webp' })

const strips = Array.from({ length: 5 }, (_, i) => i)
---

<div class="divided" style={`--photo: url(${background.src})`}>
  {strips.map((i) => (
    <div class="strip" style={`--i: ${i}`}>
      <div class="positioner">
        <div class="image" />
      </div>
    </div>
  ))}
</div>

<script>
  import './main'
</script>

<style>
  .divided {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: #000;
  }

  /* 帯ごとに奥行きを付ける。回転の消失点は帯ごとの真ん中になる */
  .strip {
    position: relative;
    height: 20%;
    overflow: hidden;
    perspective: 500px;
  }

  .strip::before {
    position: absolute;
    inset: 0 0 auto;
    z-index: 1;
    height: 1px;
    content: "";
    background: #333;
  }

  /* どの帯にも画面と同じ大きさの写真を置き、帯の位置の分だけ上へずらす。止まっていれば 1 枚の写真に見える */
  .positioner {
    position: absolute;
    top: calc(var(--i) * -100%);
    left: 0;
    width: 100%;
    height: 500%;
    will-change: transform;
  }

  /* 動かしても端が見えないよう、写真を一回り大きくしておく */
  .image {
    position: absolute;
    inset: -10%;
    background: var(--photo) center / cover;
  }
</style>
