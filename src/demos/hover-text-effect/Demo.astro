<div class="stage">
  <h1>hover action</h1>
  <button class="toggle" type="button">
    <span>appa</span>
    <span>appapa</span>
  </button>
</div>

<style>
  .stage {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
    align-items: center;
    justify-content: center;
    padding: 16px;
    color: #111;
    color-scheme: light;
    background: #fff;
  }

  h1 {
    margin: 0;
    font-size: 32px;
  }

  /* ふだんは中身のない黒い箱。マウスを乗せると、文字が左から幅を広げて出てくる */
  .toggle {
    display: block;
    width: 6.25em;
    padding: 0;
    font: inherit;
    font-size: 40px;
    line-height: 1.2;
    color: #fff;
    text-align: left;
    cursor: pointer;
    background-color: #000;
    border: 0;
    border-radius: 0;
  }

  .toggle span {
    display: block;
    width: 0;
    overflow: hidden;
    white-space: nowrap;
    transition: width 0.4s;
  }

  /* 幅は文字の長さに合わせて決めている。2 行目のほうが長いので、遅れて出きったように見える */
  .toggle:is(:hover, :focus-visible) span:nth-of-type(1) {
    width: 3em;
  }

  .toggle:is(:hover, :focus-visible) span:nth-of-type(2) {
    width: 4em;
  }
</style>
