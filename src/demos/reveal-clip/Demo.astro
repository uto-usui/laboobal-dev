---
import { Picture } from 'astro:assets'
import photo from './assets/photo.jpg'
---

<div class="stage">
  <div class="frame">
    <Picture
      class="photo"
      src={photo}
      formats={['avif']}
      fallbackFormat="webp"
      loading="eager"
      alt=""
    />
  </div>
  <button class="demo-replay" type="button">replay</button>
</div>

<script>
  import './main'
</script>

<style>
  .stage {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    container-type: size;
    overflow: hidden;
    cursor: pointer;
  }

  /* 入れ物の幅の 80% と高さの 80% の、どちらにも収まる 16:9 */
  .frame {
    position: relative;
    width: min(80cqw, 80cqh * 16 / 9);
    aspect-ratio: 16 / 9;
  }

  .photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    clip-path: inset(0% 100% 0% 0%);
  }
</style>
