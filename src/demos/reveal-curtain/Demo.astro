---
import photo from './assets/photo.jpg'
---

<div class="stage">
  <div class="frame">
    <img class="photo" src={photo.src} alt="" />
    <div class="mask"></div>
  </div>
  <button class="demo-replay" type="button">
    replay
  </button>
</div>

<script>
  import './main'
</script>

<style>
  .stage {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    container-type: size;
    overflow: hidden;
    cursor: pointer;
  }

  /* 入れ物の幅の 80% と高さの 80% の、どちらにも収まる 16:9 */
  .frame {
    position: relative;
    width: min(80cqw, 80cqh * 16 / 9);
    aspect-ratio: 16 / 9;
  }

  .photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
  }

  /* 幕。地の暗い色の上で見えるよう、サイトの差し色にしている */
  .mask {
    position: absolute;
    inset: 0;
    background: #25ecb7;
    clip-path: inset(0% 0% 0% 100%);
  }
</style>
